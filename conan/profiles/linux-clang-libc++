# Conan profile: linux-clang-libc++ (046-atomic-shared-ptr T013)
# Tier-2 lane: libc++ portability check for fixpp::sync::atomic_shared_ptr
# (NFR-017). Mirrors linux-clang-debug but uses compiler.libcxx=libc++.
# CI-deferred: the full libc++ dep rebuild is not run locally by default.
#
# Toolchain notes:
#   libc++ on this host: installed alongside Clang 22 via llvm.org apt.
#   The -stdlib=libc++ flag is forwarded through cflags/cxxflags so Conan
#   passes it to every dependency that is rebuilt (with_otel=False avoids
#   the OTel SDK rebuild — the primary value on this lane).

[settings]
os=Linux
arch=x86_64
build_type=Debug
compiler=clang
compiler.version=22
compiler.libcxx=libc++
compiler.cppstd=23

[buildenv]
CC=clang-22
CXX=clang++-22
CXXFLAGS=-stdlib=libc++
LDFLAGS=-stdlib=libc++

[conf]
tools.cmake.cmaketoolchain:generator=Ninja

# Disable Conan's CMakeUserPresets.json (084, 2026-08-02).
# Conan names its generated preset from build_type ALONE -- every Release profile
# emits "conan-release" and every Debug profile "conan-debug" (10 of the 14
# profiles here are Debug). CMakeUserPresets.json accumulates one `include:` per
# `conan install -of <dir>`, so the SECOND output folder of the same build_type
# makes the names collide and CMake then refuses to read ANY presets:
#     CMake Error: Could not read presets from ...: Duplicate preset: "conan-release"
# which breaks `cmake --preset <anything>`, not just the colliding pair.
# We never use conan-release/conan-debug: the tracked CMakePresets.json carries
# all 15 presets and points CMAKE_TOOLCHAIN_FILE at each build/<preset>/
# conan_toolchain.cmake itself. Empty value = do not generate the file.
tools.cmake.cmaketoolchain:user_presets=
