# Conan profile: windows-msvc-asan
# Windows Tier 2 ASan — MSVC /fsanitize=address per [const §IX.3].
# UBSan unavailable on MSVC; Linux Clang UBSan covers language-level UB.
# clang-cl is PROHIBITED per [const §II.2]; MSVC only.
# Pins are revisited at first CI failure; MSVC 194 (VS 2022) is the 2026 baseline.

[settings]
os=Windows
arch=x86_64
build_type=Debug
compiler=msvc
compiler.version=194
compiler.runtime=dynamic
compiler.cppstd=23

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:cxxflags=["/fsanitize=address"]
