# Conan profile: linux-clang-tsan
# TSan build — Linux/Clang only per [const §IX.2]; shared libs for ABI visibility.
# TSan and ASan cannot be combined.
# Pins are revisited at first CI failure; Clang 22 (matches user's local install; CI provisions via apt.llvm.org).

[settings]
os=Linux
arch=x86_64
build_type=Debug
compiler=clang
compiler.version=22
compiler.libcxx=libstdc++11
compiler.cppstd=23

[buildenv]
CC=clang-22
CXX=clang++-22
CXXFLAGS=-fsanitize=thread
# CFLAGS mirrors CXXFLAGS — see linux-clang-asan for the full #252 rationale.
# This is the lane the defect was MEASURED on: libcrypto.a 50,830 symbols and
# zero __tsan_*, likewise libz/libssl/libcurl/libcivetweb, while the two C++
# archives (libcivetweb-cpp.a, libpugixml.a) were instrumented — which is why it
# went unnoticed. Under TSan the gap is not merely missing coverage: the
# sanitizer cannot see accesses OR synchronisation performed in uninstrumented
# code, so it produces false negatives and can report false positives on
# correctly-synchronised data.
CFLAGS=-fsanitize=thread
LDFLAGS=-fsanitize=thread

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:cxxflags=["-fsanitize=thread"]
tools.build:cflags=["-fsanitize=thread"]
tools.build:sharedlinkflags=["-fsanitize=thread"]
tools.build:exelinkflags=["-fsanitize=thread"]
# See linux-clang-asan for rationale on tools.info.package_id:confs.
tools.info.package_id:confs=["tools.build:cxxflags", "tools.build:cflags", "tools.build:sharedlinkflags", "tools.build:exelinkflags"]

# Disable Conan's CMakeUserPresets.json (084, 2026-08-02).
# Conan names its generated preset from build_type ALONE -- every Release profile
# emits "conan-release" and every Debug profile "conan-debug" (12 of the 15
# profiles here are Debug). CMakeUserPresets.json accumulates one `include:` per
# `conan install -of <dir>`, so the SECOND output folder of the same build_type
# makes the names collide and CMake then refuses to read ANY presets:
#     CMake Error: Could not read presets from ...: Duplicate preset: "conan-release"
# which breaks `cmake --preset <anything>`, not just the colliding pair.
# We never use conan-release/conan-debug: the tracked CMakePresets.json carries
# all 16 presets and points CMAKE_TOOLCHAIN_FILE at each build/<preset>/
# conan_toolchain.cmake itself. Empty value = do not generate the file.
tools.cmake.cmaketoolchain:user_presets=
