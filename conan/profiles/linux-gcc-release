# Conan profile: linux-gcc-release
# GCC sanity build — Linux CI only per [const §II.2].
# Pins are revisited at first CI failure; GCC 13 is the conservative 2026 baseline.

[settings]
os=Linux
arch=x86_64
build_type=Release
compiler=gcc
compiler.version=13
compiler.libcxx=libstdc++11
compiler.cppstd=23

[buildenv]
CC=gcc-13
CXX=g++-13

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
