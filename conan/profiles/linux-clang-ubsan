# Conan profile: linux-clang-ubsan
# UBSan build — Linux/Clang only per [const §IX.2]; shared libs for ABI visibility.
# Pins are revisited at first CI failure; Clang 22 (matches user's local install; CI provisions via apt.llvm.org).

[settings]
os=Linux
arch=x86_64
build_type=Debug
compiler=clang
compiler.version=22
compiler.libcxx=libstdc++11
compiler.cppstd=23

[buildenv]
CC=clang-22
CXX=clang++-22
CXXFLAGS=-fsanitize=undefined -fno-omit-frame-pointer
# CFLAGS mirrors CXXFLAGS — see linux-clang-asan for the full #252 rationale.
#
# -fno-sanitize=function is C-SIDE ONLY and deliberately absent from CXXFLAGS.
# The check fires on C's generic-callback idiom — a typed function called through
# a `void (*)(void *)`, e.g. OPENSSL_sk_pop_free(sk, X509_NAME_ENTRY_free). That is
# UB by the C standard but works on every real ABI, and OpenSSL cannot drop it
# without an ABI change. #252 instrumented the C closure for the first time and it
# produced 363 reports on linux-clang-ubsan / 362 on the libc++ twin, all this one
# check. Measured with clang-22: removing it leaves 17 checks active — alignment,
# array-bounds, bool, builtin, ENUM, float-cast-overflow, integer-divide-by-zero,
# nonnull-attribute, null, pointer-overflow, return, returns-nonnull-attribute,
# shift-base, shift-exponent, signed-integer-overflow, unreachable, vla-bound.
# `enum` surviving matters: it is the check behind #268's own finding.
# ⚠️ Keep this line byte-identical to linux-clang-libc++-ubsan's. OpenSSL erases
# compiler.libcxx from its package_id (pure C), so the two lanes share ONE OpenSSL
# binary only while their cflags match; diverging here silently forks the build.
CFLAGS=-fsanitize=undefined -fno-omit-frame-pointer -fno-sanitize=function
LDFLAGS=-fsanitize=undefined

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:cxxflags=["-fsanitize=undefined", "-fno-omit-frame-pointer"]
tools.build:cflags=["-fsanitize=undefined", "-fno-omit-frame-pointer", "-fno-sanitize=function"]
tools.build:sharedlinkflags=["-fsanitize=undefined"]
tools.build:exelinkflags=["-fsanitize=undefined"]
# See linux-clang-asan for rationale on tools.info.package_id:confs.
tools.info.package_id:confs=["tools.build:cxxflags", "tools.build:cflags", "tools.build:sharedlinkflags", "tools.build:exelinkflags"]

# Disable Conan's CMakeUserPresets.json (084, 2026-08-02).
# Conan names its generated preset from build_type ALONE -- every Release profile
# emits "conan-release" and every Debug profile "conan-debug" (12 of the 15
# profiles here are Debug). CMakeUserPresets.json accumulates one `include:` per
# `conan install -of <dir>`, so the SECOND output folder of the same build_type
# makes the names collide and CMake then refuses to read ANY presets:
#     CMake Error: Could not read presets from ...: Duplicate preset: "conan-release"
# which breaks `cmake --preset <anything>`, not just the colliding pair.
# We never use conan-release/conan-debug: the tracked CMakePresets.json carries
# all 16 presets and points CMAKE_TOOLCHAIN_FILE at each build/<preset>/
# conan_toolchain.cmake itself. Empty value = do not generate the file.
tools.cmake.cmaketoolchain:user_presets=
