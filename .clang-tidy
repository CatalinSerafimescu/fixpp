# .clang-tidy — fixpp clang-tidy configuration
# Mandated checks: [const §IX.4]
# Suppressed: fuchsia-* (not relevant), llvm-header-guard (incompatible with #pragma once)
# Phase 3 default — tighten suppressions as real code lands in Phase 4.

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  hicpp-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -fuchsia-*,
  -llvm-header-guard,
  -llvm-include-order,
  -llvm-*,
  -google-build-using-namespace,
  -google-readability-todo,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -misc-non-private-member-variables-in-classes,
  -hicpp-avoid-c-arrays,
  -cppcoreguidelines-avoid-c-arrays,
  -readability-identifier-length,
  -portability-avoid-pragma-once,
  -cppcoreguidelines-macro-usage,
  -modernize-use-using,
  -cppcoreguidelines-interfaces-global-init,
  -readability-identifier-naming,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -hicpp-no-array-decay,
  -modernize-avoid-c-arrays,
  -hicpp-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -readability-function-cognitive-complexity,
  -misc-const-correctness,
  -bugprone-signed-char-misuse,
  -cert-str34-c

# Treat clang-tidy warnings as errors in CI (FIXPP_WERROR + -Werror applies separately)
WarningsAsErrors: "*"

HeaderFilterRegex: "include/fixpp/.*|include/fix/.*"

CheckOptions:
  - key: modernize-use-default-member-init.UseAssignment
    value: "true"
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: "true"
