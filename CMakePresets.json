{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },

  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FIXPP_BUILD_TESTS": "ON",
        "FIXPP_WERROR": "ON"
      }
    },

    {
      "name": "linux-clang-debug",
      "displayName": "Linux / Clang / Debug",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-debug/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-release",
      "displayName": "Linux / Clang / Release",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-release/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-asan",
      "displayName": "Linux / Clang / ASan",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "FIXPP_ENABLE_ASAN": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-asan/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-ubsan",
      "displayName": "Linux / Clang / UBSan",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "FIXPP_ENABLE_UBSAN": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-ubsan/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-tsan",
      "displayName": "Linux / Clang / TSan",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "FIXPP_ENABLE_TSAN": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-tsan/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-coverage",
      "displayName": "Linux / Clang / Coverage",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "FIXPP_ENABLE_COVERAGE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-coverage/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-gcc-release",
      "displayName": "Linux / GCC / Release (sanity)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "FIXPP_WERROR": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-gcc-release/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-gcc-debug",
      "displayName": "Linux / GCC / Debug (sanity)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "FIXPP_WERROR": "OFF",
        "FIXPP_BUILD_OTEL": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-gcc-debug/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-libc++",
      "displayName": "Linux / Clang / libc++ (Tier-2 NFR-017)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-libc++/conan_toolchain.cmake",
        "FIXPP_LIBCXX_LANE": "ON",
        "FIXPP_BUILD_OTEL": "OFF"
      }
    },

    {
      "name": "linux-clang-libc++-asan",
      "displayName": "Linux / Clang / libc++ / ASan (Tier-3 NFR-017)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "FIXPP_ENABLE_ASAN": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "FIXPP_BUILD_OTEL": "OFF",
        "FIXPP_LIBCXX_LANE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-libc++-asan/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-libc++-ubsan",
      "displayName": "Linux / Clang / libc++ / UBSan (Tier-3 NFR-017)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "FIXPP_ENABLE_UBSAN": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "FIXPP_BUILD_OTEL": "OFF",
        "FIXPP_LIBCXX_LANE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-libc++-ubsan/conan_toolchain.cmake"
      }
    },

    {
      "name": "linux-clang-libc++-tsan",
      "displayName": "Linux / Clang / libc++ / TSan (Tier-3 NFR-017)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "FIXPP_ENABLE_TSAN": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "FIXPP_BUILD_OTEL": "OFF",
        "FIXPP_LIBCXX_LANE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-clang-libc++-tsan/conan_toolchain.cmake"
      }
    },

    {
      "name": "windows-msvc-debug",
      "displayName": "Windows / MSVC / Debug",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-msvc-debug/conan_toolchain.cmake"
      }
    },

    {
      "name": "windows-msvc-release",
      "displayName": "Windows / MSVC / Release",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-msvc-release/conan_toolchain.cmake"
      }
    },

    {
      "name": "windows-msvc-asan",
      "displayName": "Windows / MSVC / ASan (Tier 2)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-msvc-asan/conan_toolchain.cmake",
        "FIXPP_ENABLE_ASAN": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "linux-clang-debug",    "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release",  "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-asan",     "configurePreset": "linux-clang-asan" },
    { "name": "linux-clang-ubsan",    "configurePreset": "linux-clang-ubsan" },
    { "name": "linux-clang-tsan",     "configurePreset": "linux-clang-tsan" },
    { "name": "linux-clang-coverage", "configurePreset": "linux-clang-coverage" },
    { "name": "linux-gcc-release",    "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-debug",      "configurePreset": "linux-gcc-debug" },
    { "name": "linux-clang-libc++",        "configurePreset": "linux-clang-libc++" },
    { "name": "linux-clang-libc++-asan",   "configurePreset": "linux-clang-libc++-asan" },
    { "name": "linux-clang-libc++-ubsan",  "configurePreset": "linux-clang-libc++-ubsan" },
    { "name": "linux-clang-libc++-tsan",   "configurePreset": "linux-clang-libc++-tsan" },
    { "name": "windows-msvc-debug",        "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-asan",    "configurePreset": "windows-msvc-asan" }
  ],

  "testPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-asan",
      "configurePreset": "linux-clang-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-ubsan",
      "configurePreset": "linux-clang-ubsan",
      "description": "UBSan. jobs=4 — #267 phase 2, MEASURED 1.79x (1993 -> 1114 s, ~14.6 min/run) by a PAIRED same-VM run, cross-validated on a second VM to 1.9%/4.2%. Peak 0.65 -> 0.86 GiB, 5.5% of a 15.61 GiB runner. ⚠️ Do NOT copy to another lane: tsan measured NO gain at 4 and debug is unresolved. Between-VM wall-clock variance is 27-43%, so only a paired same-VM measurement can decide a lane. See ci/ctest-parallelism-probe.md.",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "linux-clang-tsan",
      "configurePreset": "linux-clang-tsan",
      "description": "TSan. jobs=2 — MEASURED OPTIMUM on a 4-vCPU runner, not a placeholder. j=4 was tried in CI (#267 phase 1) and REVERTED: concurrency did rise 1.83x->2.73x, but wall clock moved only -3.5% (inside this lane's own 6.91% variance) because contention inflated total per-test wall-time +44%, while peak RSS rose +36%. Measurable cost, unmeasurable benefit. Do NOT re-widen without re-reading ci/ctest-parallelism-probe.md's phase-1 section.",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 2 }
    },
    {
      "name": "linux-clang-coverage",
      "configurePreset": "linux-clang-coverage",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-libc++",
      "configurePreset": "linux-clang-libc++",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-libc++-asan",
      "configurePreset": "linux-clang-libc++-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-libc++-ubsan",
      "configurePreset": "linux-clang-libc++-ubsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-libc++-tsan",
      "configurePreset": "linux-clang-libc++-tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-asan",
      "configurePreset": "windows-msvc-asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
