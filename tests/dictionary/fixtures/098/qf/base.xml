<!--
  098-dialect-overlay, contracts/witnesses.md W-1: the small QuickFIX-XML triple
  base.xml, overlay.xml and edited.xml. edited.xml is base.xml with each
  overlay.xml addition appended at the end of its matched container, in overlay
  document order (spec.md Terminology, "Equivalent edited XML"), written by hand
  and never produced by the merge (FR-017 (a)). Re-check it with a no-index
  unified diff of base.xml against edited.xml: every hunk has one of the shapes
  contracts W-1 allows. The base has no trailer, so the overlay's trailer is a
  container the base lacks (research R-3). Group NoEvents holds only the empty
  component EmptyBlock, a group whose members emit nothing, which the loader
  refuses under the default unresolved_group_policy; so base.xml is never loaded
  on its own, and the member the overlay appends to NoEvents is its first
  emission, its delimiter (spec.md Edge Cases).
-->
<fix type='FIX' major='4' minor='4' servicepack='0'>
 <header>
  <field name='BeginString' required='Y' />
  <field name='BodyLength' required='Y' />
  <field name='MsgType' required='Y' />
  <field name='SenderCompID' required='Y' />
  <field name='TargetCompID' required='Y' />
  <field name='MsgSeqNum' required='Y' />
  <field name='SendingTime' required='Y' />
 </header>
 <messages>
  <message name='Heartbeat' msgtype='0' msgcat='admin'>
   <field name='TestReqID' required='N' />
  </message>
  <message name='NewOrderSingle' msgtype='D' msgcat='app'>
   <field name='ClOrdID' required='Y' />
   <field name='Account' required='N' />
   <component name='Parties' required='N' />
   <component name='Instrument' required='Y' />
   <field name='Side' required='Y' />
   <field name='OrdType' required='Y' />
   <group name='NoAllocs' required='N'>
    <field name='AllocAccount' required='N' />
    <field name='AllocQty' />
   </group>
   <field name='Text' required='N' />
  </message>
  <message name='ExecutionReport' msgtype='8' msgcat='app'>
   <field name='OrderID' required='Y' />
   <field name='ExecID' required='Y' />
   <component name='Instrument' required='Y' />
   <group name='NoEvents' required='N'>
    <component name='EmptyBlock' required='N' />
   </group>
   <field name='BaseBlobLen' required='N' />
  </message>
 </messages>
 <components>
  <component name='Instrument'>
   <field name='Symbol' required='Y' />
   <field name='SecurityID' required='N' />
  </component>
  <component name='Parties'>
   <group name='NoPartyIDs' required='N'>
    <field name='PartyID' required='N' />
    <field name='PartyRole' required='N' />
   </group>
  </component>
  <component name='EmptyBlock'>
  </component>
 </components>
 <fields>
  <field number='1' name='Account' type='STRING' />
  <field number='8' name='BeginString' type='STRING' />
  <field number='9' name='BodyLength' type='LENGTH' />
  <field number='11' name='ClOrdID' type='STRING' />
  <field number='17' name='ExecID' type='STRING' />
  <field number='34' name='MsgSeqNum' type='SEQNUM' />
  <field number='35' name='MsgType' type='STRING' />
  <field number='37' name='OrderID' type='STRING' />
  <field number='40' name='OrdType' type='CHAR'>
   <value enum='1' description='MARKET' />
   <value enum='2' description='LIMIT' />
  </field>
  <field number='48' name='SecurityID' type='STRING' />
  <field number='49' name='SenderCompID' type='STRING' />
  <field number='52' name='SendingTime' type='UTCTIMESTAMP' />
  <field number='54' name='Side' type='CHAR'>
   <value enum='1' description='BUY' />
   <value enum='2' description='SELL' />
  </field>
  <field number='55' name='Symbol' type='STRING' />
  <field number='56' name='TargetCompID' type='STRING' />
  <field number='58' name='Text' type='STRING' />
  <field number='78' name='NoAllocs' type='NUMINGROUP' />
  <field number='79' name='AllocAccount' type='STRING' />
  <field number='80' name='AllocQty' type='QTY' />
  <field number='112' name='TestReqID' type='STRING' />
  <field number='448' name='PartyID' type='STRING' />
  <field number='452' name='PartyRole' type='INT' />
  <field number='453' name='NoPartyIDs' type='NUMINGROUP' />
  <field number='864' name='NoEvents' type='NUMINGROUP' />
  <field number='7010' name='BaseBlobLen' type='LENGTH' />
  <field number='7011' name='BaseBlob' type='DATA' />
 </fields>
</fix>
